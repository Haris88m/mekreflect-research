            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "validationNeeded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "complianceDetermination": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "status",
        "contentClass",
        "approval",
        "title",
        "summary",
        "provenance",
        "claims",
        "limitations",
        "kind",
        "caseId",
        "mappingStatus",
        "frameworkSourceId",
        "controlReference",
        "proposedImplication",
