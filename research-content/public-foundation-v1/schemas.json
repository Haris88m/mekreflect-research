          "additionalProperties": false
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "external_incident_report",
                  "public_editorial",
                  "synthetic_fixture",
                  "framework_document"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "format": "uri",
                "pattern": "^https://"
              },
              "publishedOn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "accessedOn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "verification": {
                "type": "string",
                "enum": [
                  "source_reviewed",
                  "editorial_design_only",
                  "synthetic_not_run"
                ]
              },
              "snapshotSha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            },
            "required": [
              "sourceId",
              "sourceType",
              "title",
              "url",
              "publishedOn",
              "accessedOn",
              "locator",
              "verification",
              "snapshotSha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "claimType": {
                "type": "string",
                "enum": [
                  "attributed_report",
                  "editorial_interpretation",
                  "proposed_method",
                  "policy_hypothesis",
                  "synthetic_example"
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "minItems": 1,
                "maxItems": 30
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "minItems": 1,
                "maxItems": 30
              }
            },
            "required": [
              "id",
              "text",
              "claimType",
              "sourceIds",
              "limitations"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "kind": {
          "const": "policy-mapping"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "mappingStatus": {
          "const": "proposed_not_validated"
        },
        "frameworkSourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "controlReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "proposedImplication": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidenceClaimIds": {
          "type": "array",
          "items": {
