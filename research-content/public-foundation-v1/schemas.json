                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "verification": {
                "type": "string",
                "enum": [
                  "source_reviewed",
                  "editorial_design_only",
                  "synthetic_not_run"
                ]
              },
              "snapshotSha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
