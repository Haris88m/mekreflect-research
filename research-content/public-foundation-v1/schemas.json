        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published"
          ]
        },
        "contentClass": {
          "type": "string",
          "enum": [
            "public_approved",
            "synthetic",
            "private"
          ]
        },
        "approval": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "pending"
              ]
            },
            "basis": {
              "type": "string",
              "enum": [
                "existing_public_editorial",
                "synthetic_fixture_only",
                "pending_review"
              ]
            },
            "reviewedOn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "format": "date"
            },
            "reviewRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "required": [
            "decision",
            "basis",
            "reviewedOn",
            "reviewRef"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "external_incident_report",
                  "public_editorial",
                  "synthetic_fixture",
                  "framework_document"
